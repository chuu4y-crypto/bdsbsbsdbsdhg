-- Breaks the packet throttling loop instantly
_G.ServerDesyncActive = false

-- Safe wrapper to restore normal server syncing instantly
pcall(function()
    local networkClient = game:GetService("NetworkClient")
    if networkClient then
        -- Restores your character sync to perfect real-time stability
        networkClient:SetOutgoingKBPSLimit(0) 
        settings():GetService("NetworkSettings").InboundReplicationLag = 0
    end
end)
