-- Safely kill any old running desync threads first
_G.ServerDesyncActive = false
task.wait(0.02)

_G.ServerDesyncActive = true

task.spawn(function()
    local networkClient = game:GetService("NetworkClient")
    
    while _G.ServerDesyncActive do
        -- Intercepts outbound socket updates to stop packet uploads
        -- Other players will see you freeze solid or float in mid-air
        settings():GetService("NetworkSettings").InboundReplicationLag = 0
        
        -- Forces your network traffic to buffer outbound replication updates
        networkClient:SetOutgoingKBPSLimit(1) 
        task.wait(0.48) -- Hold time for massive warp/teleport distance
        
        -- Instant packet flush to jump your character to your new location
        networkClient:SetOutgoingKBPSLimit(999999)
        task.wait(0.01)
    end
end)
