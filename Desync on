_G.InsaneLagActive = false
task.wait(0.01)

_G.InsaneLagActive = true

task.spawn(function()
    local settings = settings():GetService("NetworkSettings")
    
    while _G.InsaneLagActive do
        -- Complete network choke (simulates 0 bandwidth)
        settings.InboundReplicationLag = 999999999
        
        -- Holds the freeze for over half a second. 
