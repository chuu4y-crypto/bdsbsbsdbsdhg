-- Kill previous loops to prevent stacking
_G.DesyncActive = false
task.wait(0.05)

_G.DesyncActive = true

task.spawn(function()
    local settings = settings():GetService("NetworkSettings")
    
    -- Loop cycles replication lag to maximize packet choke without disconnecting you
    while _G.DesyncActive do
        settings.InboundReplicationLag = 50 -- Heavy network stall
        task.wait(0.15)
        settings.InboundReplicationLag = 0  -- Quick catch-up to prevent crash
        task.wait(0.01)
    end
end)
