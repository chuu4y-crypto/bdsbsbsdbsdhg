-- Set the global flag to active
_G.LagSwitchActive = true

local players = game:GetService("Players")
local client = players.LocalPlayer

-- Prevent duplicate background loops from running simultaneously
if _G.LagSwitchLoopRunning then return end
_G.LagSwitchLoopRunning = true

task.spawn(function()
    local sleepnet = true
    while _G.LagSwitchActive do
        local clientCharacter = client.Character
        if clientCharacter and clientCharacter:FindFirstChild("HumanoidRootPart") then
            local hrp = clientCharacter.HumanoidRootPart
            local oldpos = hrp.CFrame 
            
            sleepnet = not sleepnet
            sethiddenproperty(hrp, "NetworkIsSleeping", sleepnet) 
            
            if not sleepnet then 
                hrp.CFrame = hrp.CFrame + Vector3.new(10, 0, 10) 
            end 
            
            hrp.CFrame = oldpos 
            task.wait(0.15) -- Adjust timing for heavier or lighter lag
        else
            task.wait(0.1) -- Short wait if character is missing
        end
    end
    
    -- Clean up and restore physics when the loop terminates
    _G.LagSwitchLoopRunning = false
    local clientCharacter = client.Character
    if clientCharacter and clientCharacter:FindFirstChild("HumanoidRootPart") then
        sethiddenproperty(clientCharacter.HumanoidRootPart, "NetworkIsSleeping", false)
    end
end)
