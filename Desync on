-- Safety kill for old active loops
_G.ExtremeLagswitchActive = false
task.wait(0.03)

_G.ExtremeLagswitchActive = true

task.spawn(function()
    local netSettings = settings():GetService("NetworkSettings")
    
    while _G.ExtremeLagswitchActive do
        -- Simulates PhysicsSenderMaxBandwidthBps = 9 and InboundReplicationLag
        netSettings.InboundReplicationLag = 999999
        
        -- Holds the choke open to heavily restrict all positional data updates
        task.wait(0.45) 
        
        -- Flash release to update your client status so you don't get kicked
        netSettings.InboundReplicationLag = 0
        task.wait(0.01)
    end
end)
